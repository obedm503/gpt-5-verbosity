{
  "name": "gpt-5-verbosity",
  "version": "0.1.0",
  "description": "OpenCode plugin: cycle text verbosity (unset/low/medium/high) for GPT-5 models with ctrl+v, stored per session with a global default",
  "type": "module",
  "exports": {
    "./server": {
      "import": "./src/server.ts"
    },
    "./tui": {
      "import": "./src/tui.tsx"
    }
  },
  "engines": {
    "opencode": ">=1.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.3",
    "@opentui/core": "0.4.3",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.3",
    "@types/node": "^26.1.1",
    "solid-js": "1.9.12",
    "typescript": "^7.0.2"
  }
}
